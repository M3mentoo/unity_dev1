* text=auto

# Keep source and configuration files consistent across platforms.
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.shader text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Unity serialized assets are YAML text when Force Text serialization is used.
*.anim text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.unity text eol=lf

# Common binary assets.
*.dll binary
*.fbx binary
*.gif binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.ogg binary
*.png binary
*.psd binary
*.tga binary
*.wav binary

